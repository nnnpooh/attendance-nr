dialog(open)
    article
        header
            button(aria-label="Close" rel="prev" data-close-dialog)
            strong Manual check-in
        p
            strong=`${student.id} ${student.firstname} ${student.lastname}`
            br
            span=`${courseKey(meeting.section.course)} sec ${meeting.section.number} · meeting ${fmtDateTime(meeting.startsAt)}`
        form(hx-post="/checkins")
            input(type="hidden" name="meetingId" value=meeting.id)
            input(type="hidden" name="studentId" value=student.id)
            label Time
                input(type="datetime-local" name="checkedAt" value=defaultTime required)
            label Reason
                input(name="reason" required autofocus placeholder="e.g. LINE not working, came late with permission")
            footer
                button(type="button" class="secondary" data-close-dialog) Cancel
                |
                button(type="submit") Check in

- const p = typeof path === "string" ? path : ""
- const at = (prefix) => (p === prefix || p.startsWith(prefix + "/")) ? "page" : null
header
    nav
        ul
            li
                a(href="/" class="custom-icon" title="Home")
                    i(class="fa-solid fa-xl fa-home")
        if user && user.isAdmin
            ul
                li
                    a(href="/meetings" aria-current=at("/meetings")) Check-Ins
                li
                    a(href="/students" aria-current=at("/students")) Students
                li
                    a(href="/courses" aria-current=at("/courses")) Courses
                li
                    a(href="/import" aria-current=at("/import")) Import
        if !user
            ul
                li
                    a(href="/login" class="custom-icon")
                        i(class="fa-solid fa-xl fa-right-to-bracket")
        else
            ul
                li
                    a(href="/account" title="Account & sessions")
                        em=user.name
                li
                    a(href="#" class="custom-icon" hx-post="/logout" title="Log Out")
                        i(class="fa-solid fa-xl fa-right-from-bracket pico-color-red-400")

//- Shared mixins, included once by layouts/main.pug.

//- <select name="sectionId"> grouped by course.
mixin sectionSelect(courses, selected, emptyLabel)
    select(name="sectionId" required=!emptyLabel)
        if emptyLabel
            option(value="")=emptyLabel
        else
            option(value="" disabled selected=!selected) Choose Course and Section…
        each c in courses
            optgroup(label=(c.name ? `${c.key} — ${c.name}` : c.key))
                each s in c.sections
                    option(value=s.id selected=(s.id === selected))=`${c.code} Sec ${s.number} (${s.studentCount} students)`

//- Open / Closed badge for a meeting.
mixin meetingStatus(m, now)
    if m.startsAt <= now && now < m.endsAt
        mark Open
    else if now < m.startsAt
        span Scheduled
    else
        small Closed

//- One cell of the course attendance grid. Clicking opens the "Edit attendance" dialog.
//- Absent cells are only clickable for enrolled students (`clickable`).
mixin checkinCell(checkin, meetingId, studentId, clickable)
    - const edit = `/meetings/${meetingId}/attendance/${studentId}`
    if checkin
        td(class=`cell present ${checkin.method === "MANUAL" ? "manual" : ""}`
            title=(checkin.method === "MANUAL" ? `Manual: ${checkin.reason || ""}` : `LINE ${fmtDateTime(checkin.checkedAt)}`)
            hx-get=edit hx-target="#modal")
            if checkin.method === "MANUAL"
                i(class="fa-solid fa-pen-to-square")
                = " "
            = fmtTime(checkin.checkedAt)
    else if clickable
        td(class="cell absent clickable" title="Absent — click to mark present"
            hx-get=edit hx-target="#modal") ·
    else
        td(class="cell absent")

//- Status / Time / Method / pen columns for one student on the check-in page.
mixin attendanceCols(checkin, meetingId, studentId)
    td
        if checkin
            span(class="badge present") Present
        else
            span(class="badge absent") Absent
    td=checkin ? fmtTime(checkin.checkedAt) : "—"
    td
        if !checkin
            | —
        else if checkin.method === "MANUAL"
            div(class="truncate" title=checkin.reason)
                | Manual
                if checkin.reason
                    small=` — ${checkin.reason}`
        else
            | LINE
    td(class="row-actions")
        a(href="#" title="Edit Attendance" class="icon-action"
            hx-get=`/meetings/${meetingId}/attendance/${studentId}` hx-target="#modal")
            i(class="fa-solid fa-pen")

//- Pen + trash icons at the end of a table row. Extra attributes go to the trash link.
mixin rowActions(editHref)
    td(class="row-actions")
        if editHref
            a(href=editHref title="Edit" class="icon-action")
                i(class="fa-solid fa-pen")
        a(href="#" title="Delete" class="icon-action danger")&attributes(attributes)
            i(class="fa-solid fa-trash-can")

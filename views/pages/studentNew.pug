extends ../layouts/main.pug

block content
    nav(aria-label="breadcrumb")
        ul
            li
                a(href="/students") Students
            li New
    h1 New student
    article
        form(hx-post="/students")
            div(class="grid")
                label Student ID
                    input(name="id" required pattern="[67][0-9]{8}" title="9 digits starting with 6 or 7" placeholder="650612345" autofocus)
                label First name
                    input(name="firstname" required)
                label Last name
                    input(name="lastname" required)
            label Enroll in (optional)
                +sectionSelect(courses, null, "— not now —")
            div(class="page-actions")
                button(type="submit") Create
                a(href="/students" role="button" class="secondary") Cancel

extends ../layouts/main.pug

block content
    nav(aria-label="breadcrumb")
        ul
            li
                a(href="/courses") Courses
            li=course.key
    div(class="page-head")
        hgroup
            h1=course.key
            if course.name
                p=course.name
        a(href=`/courses/${course.id}/edit` role="button" class="secondary")
            i(class="fa-solid fa-pen")
            |  Edit Course

    if !section
        article
            em
                | This course has no sections yet —
                a(href=`/courses/${course.id}/edit`) add some
                | .
    else
        //- Section tabs
        div(class="chips tabs")
            each s in course.sections
                a(href=`/courses/${course.id}?section=${s.id}`
                    class=`chip ${s.id === section.id ? "active" : ""}`
                    aria-current=(s.id === section.id ? "page" : null))=`Sec ${s.number}`
                    small=` (${s.studentCount})`

        div(class="page-actions")
            a(href=`/meetings/new?section=${section.id}` role="button")
                i(class="fa-solid fa-play")
                |  New Check-In for Sec #{section.number}
            a(href=`/sections/${section.id}/attendance.csv` role="button" class="secondary")
                i(class="fa-solid fa-download")
                |  Download CSV

        h3=`Secs ${section.number} · ${pivot.enrolledRows.length} Student(s) · ${pivot.meetings.length} Check-In(s)`
        div(class="overflow-auto")
            table(class="pivot striped")
                thead
                    tr
                        th ID
                        th Name
                        each m in pivot.meetings
                            th(class="meeting-head" title=fmtDateTime(m.startsAt))
                                a(href=`/meetings/${m.id}`)
                                    = fmt(m.startsAt, "DD/MM")
                                    br
                                    small=fmtTime(m.startsAt)
                        if pivot.meetings.length
                            th Present
                tbody
                    each row in pivot.enrolledRows
                        tr
                            td
                                a(href=`/students/${row.student.id}`)=row.student.id
                            td(class="name")=`${row.student.firstname} ${row.student.lastname}`
                            each cell in row.cells
                                +checkinCell(cell.checkin, cell.meetingId, row.student.id, true)
                            if pivot.meetings.length
                                td=`${row.present}/${pivot.meetings.length}`
                    if !pivot.enrolledRows.length
                        tr
                            td(colspan=pivot.meetings.length + 3)
                                em
                                    | No students in this section.


        if pivot.otherRows.length
            h3(class="pico-color-amber-400")=`Checked In Here but NOT Enrolled in Sec ${section.number} (${pivot.otherRows.length})`
            div(class="overflow-auto")
                table(class="pivot striped")
                    thead
                        tr
                            th ID
                            th Name
                            th Enrolled In
                            each m in pivot.meetings
                                th(class="meeting-head")
                                    = fmt(m.startsAt, "DD/MM")
                                    br
                                    small=fmtTime(m.startsAt)
                            th
                    tbody
                        each row in pivot.otherRows
                            tr
                                td
                                    a(href=`/students/${row.student.id}`)=row.student.id
                                td(class="name")=`${row.student.firstname} ${row.student.lastname}`
                                td
                                    if row.enrolledSection
                                        a(href=`/courses/${course.id}?section=${row.enrolledSection.id}`)=`Sec ${row.enrolledSection.number}`
                                    else
                                        em not in #{course.key}
                                each cell in row.cells
                                    +checkinCell(cell.checkin, cell.meetingId, row.student.id, false)
                                td
                                    button(class="outline small"
                                        hx-post=`/sections/${section.id}/enroll`
                                        hx-vals=JSON.stringify({ studentId: row.student.id })
                                        hx-confirm=(row.enrolledSection ? `Move ${row.student.id} from Sec ${row.enrolledSection.number} to Sec ${section.number}?` : `Enroll ${row.student.id} in Sec ${section.number}?`))
                                        = row.enrolledSection ? "Move Here" : "Enroll Here"

        if pivot.meetings.length
            details(class="legend-help")
                summary How to Read This Table
                ul
                    li
                        span(class="legend present") 10:02
                        |  Checked in via LINE at that time.
                    li
                        span(class="legend present manual")
                            i(class="fa-solid fa-pen-to-square")
                            |  10:02
                        |  Marked present manually. Hover to see the reason.
                    li
                        span(class="legend absent") ·
                        |  Absent.
                    li Click any cell to edit it: mark an absent student present, change a manual check-in's time or reason, or mark someone absent.
                    li Click a date in the header to open that check-in's page.
                    li
                        strong Present
                        |  is the number of check-ins the student attended out of all check-ins of this section.
                    li
                        | "Checked In Here but NOT Enrolled" lists students from another section or course who checked in to this section. Use
                        strong  Move Here
                        |  /
                        strong  Enroll Here
                        |  to fix their enrollment.

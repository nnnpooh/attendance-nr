extends ../layouts/main.pug

block content
    div(class="page-head")
        h1 Courses
        a(href="/courses/new" role="button")
            i(class="fa-solid fa-plus")
            |  New Course

    if courses.length
        div(class="overflow-auto")
            table(class="striped")
                thead
                    tr
                        th Course
                        th Name
                        th Sections (Students)
                        th Students
                        th Check-Ins
                        th
                tbody
                    each c in courses
                        tr
                            td
                                a(href=`/courses/${c.id}`)
                                    strong=c.key
                            td=c.name
                            td
                                if c.sections.length
                                    div(class="chips")
                                        each s in c.sections
                                            a(href=`/courses/${c.id}?section=${s.id}` class="chip")=s.number
                                                small=` (${s.studentCount})`
                                else
                                    em
                                        small none
                            td=c.studentCount
                            td=c.meetingCount
                            +rowActions(`/courses/${c.id}/edit`)(
                                hx-delete=`/courses/${c.id}`
                                hx-prompt=`Delete ${c.key} with ALL ${c.sections.length} section(s), ${c.studentCount} enrollment(s) and ${c.meetingCount} check-in(s)? This cannot be undone.\n\nType the course code (${c.code}) to confirm:`)
    else
        article
            em No courses yet.

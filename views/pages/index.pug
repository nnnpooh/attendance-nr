extends ../layouts/main.pug

block content
    if user
        h1 Attendance
        article
            p
                strong Not authorized.
                |  This app is for admin accounts only.
        p
            a(href="/account") Account & Sessions
    else
        section(class="hero")
            div(class="hero-content")
                h1 ATTENDANCE
                div(class="hero-actions")
                    a(href="/start" role="button")
                        i(class="fa-solid fa-circle-play")
                        |  Get Started
                    a(href="/login" role="button" class="secondary")
                        i(class="fa-solid fa-right-to-bracket")
                        |  Log In

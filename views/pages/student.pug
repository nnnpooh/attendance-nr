extends ../layouts/main.pug

block content
    nav(aria-label="breadcrumb")
        ul
            li
                a(href="/students") Students
            li=student.id
    div(class="page-head")
        hgroup
            h1=`${student.firstname} ${student.lastname}`
            p=student.id
        a(href=`/students/${student.id}/edit` role="button" class="secondary")
            i(class="fa-solid fa-pen")
            |  Edit student

    article
        header
            strong LINE
        if student.lineAccount
            p
                i(class="fa-solid fa-check pico-color-green-400")
                = ` Linked${student.lineAccount.displayName ? ` to "${student.lineAccount.displayName}"` : ""} on ${fmtDateTime(student.lineAccount.linkedAt)}`
        else
            p
                em Not registered on LINE yet (student sends REG:#{student.id}).

    article
        header
            strong Courses
        if enrollments.length
            table
                thead
                    tr
                        th Course
                        th Section
                tbody
                    each e in enrollments
                        tr
                            td
                                a(href=`/courses/${e.courseId}?section=${e.sectionId}`)=e.key
                                if e.course.name
                                    small=` — ${e.course.name}`
                            td=`sec ${e.section.number}`
        else
            p
                em Not enrolled in any course.

    article
        header
            strong=`Check-ins (${checkins.length})`
        if checkins.length
            div(class="overflow-auto")
                table(class="striped")
                    thead
                        tr
                            th Course
                            th Section
                            th Meeting
                            th Checked in
                            th Method
                    tbody
                        each c in checkins
                            tr
                                td=c.key
                                td=`sec ${c.section}`
                                td
                                    a(href=`/meetings/${c.meetingId}`)=fmtDateTime(c.meetingStartsAt)
                                td=fmtDateTime(c.checkedAt)
                                td
                                    = c.method
                                    if c.reason
                                        small=` (${c.reason})`
        else
            p
                em No check-ins.
